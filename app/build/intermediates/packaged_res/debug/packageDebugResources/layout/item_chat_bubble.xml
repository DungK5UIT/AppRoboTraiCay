<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_chat_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- BOT Message (left side) -->
    <LinearLayout
        android:id="@+id/ll_bot_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Bot Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/hotro1"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bot hỗ trợ"
                android:textSize="10sp"
                android:textColor="#9E9E9E"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/tv_bot_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="260dp"
                android:background="@drawable/bg_chat_bot"
                android:padding="12dp"
                android:text=""
                android:textColor="#212121"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- USER Message (right side) -->
    <LinearLayout
        android:id="@+id/ll_user_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bạn"
                android:textSize="10sp"
                android:textColor="#9E9E9E"
                android:layout_marginBottom="2dp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_user_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="260dp"
                android:background="@drawable/bg_chat_user"
                android:padding="12dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <!-- User Avatar -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:background="@color/primary_color"
            android:padding="6dp" />

    </LinearLayout>

</LinearLayout>
